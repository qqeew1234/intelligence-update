{
  "name": "intelligence-update",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:next": "next dev",
    "build": "vite build",
    "build:next": "next build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "sync": "tsx scripts/sync.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.5.0",
    "fast-xml-parser": "^5.0.8",
    "lucide-react": "^0.475.0",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.4.0",
    "wrangler": "^4.168.0"
  },
  "type": "module"
}
