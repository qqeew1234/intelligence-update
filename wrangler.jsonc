{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intelligence-update",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "ai.yunyun.page",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "INTELLIGENCE_KV",
      "id": "eb3f4b4497ff417e8bbd179db6bab875"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
