# Optional: Add one of these keys in .env.local to enable Korean AI summarization & classification.
# Without an API key, Intelligence Update automatically falls back to deterministic rule-based summaries.

# Google Gemini API (gemini-2.5-flash)
GEMINI_API_KEY=

# OpenAI API (gpt-4o-mini) - used if GEMINI_API_KEY is not set
OPENAI_API_KEY=
