# Optional: Add a Gemini API key in .env.local (or as a Cloudflare Worker secret)
# to enable Gemini-powered rumor organization, credibility scoring, and evidence evaluation.
# Without an API key, Rumor Radar automatically falls back to deterministic heuristic evaluation.

GEMINI_API_KEY=

# Optional: Override the Gemini model used for Rumor Radar evaluation (default: gemini-3.5-flash-lite)
# Supported options include: gemini-3.5-flash-lite, gemini-4-hydrogen
GEMINI_RUMOR_MODEL=gemini-3.5-flash-lite
